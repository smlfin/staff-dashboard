datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  employeeCode  String    @unique
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  branch        String
  designation   String
  role          String    @default("staff")
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  @@index([employeeCode])
  @@index([branch])
}

model EmployeeDirectory {
  employeeCode  String   @id
  employeeName  String
  branch        String
  designation   String
  createdAt     DateTime @default(now())
}

model StaffRecord {
  id                       String    @id @default(cuid())
  timestamp                DateTime
  date                     DateTime
  branchName               String
  employeeCode             String
  employeeName             String
  designation              String
  activityType             String
  typeOfCustomer           String
  leadSource               String
  howContacted             String?
  prospectName             String
  phoneNumber              String
  address                  String?
  profession               String?
  dob                      String?
  productInterested        String
  remarks                  String?
  nextFollowUpDate         DateTime?
  relationWithStaff        String?
  profileOfCustomer        String?
  averageMonthlyIncome     String?
  familyDetailsWife        String?
  familyDetailsJobWife     String?
  familyDetailsChildren    String?
  familyDetailsChildrenDetails String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([employeeCode])
  @@index([date])
  @@index([branchName])
  @@index([activityType])
}

model RefreshToken {
  id           String   @id @default(cuid())
  employeeCode String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [employeeCode], references: [employeeCode], onDelete: Cascade)

  @@index([employeeCode])
}

model AuditLog {
  id           String   @id @default(cuid())
  employeeCode String
  action       String
  resourceType String?
  resourceId   String?
  details      String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [employeeCode], references: [employeeCode], onDelete: Cascade)

  @@index([employeeCode])
  @@index([createdAt])
  @@index([action])
}
