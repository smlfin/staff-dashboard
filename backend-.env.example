# backend/.env.example

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Production
# DATABASE_URL="postgresql://username:password@host:port/database?schema=public"

# PostgreSQL Development (local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/staff_dashboard"

# SQLite Development (easiest for local testing)
# DATABASE_URL="file:./dev.db"

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

PORT=5000
NODE_ENV=development

# ============================================================================
# JWT & SECURITY
# ============================================================================

# Change these to strong random strings in production!
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-32-chars-min
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this-in-production-32-chars

JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ============================================================================
# CORS & FRONTEND
# ============================================================================

FRONTEND_URL=http://localhost:3000

# For production: https://yourdomain.com

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

LOG_LEVEL=debug
# Options: error, warn, info, debug, trace

# Optional: Sentry for error tracking
# SENTRY_DSN=https://key@sentry.io/project-id

# ============================================================================
# RATE LIMITING
# ============================================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# ============================================================================
# FILE UPLOADS (if needed)
# ============================================================================

MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=csv,xlsx,xls

# ============================================================================
# EMAIL CONFIGURATION (optional, for notifications)
# ============================================================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourcompany.com
